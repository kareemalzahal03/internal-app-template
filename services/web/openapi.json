  "components": {
    "schemas": {
      "ClientCreate": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "status": {
            "$ref": "#/components/schemas/ClientStatus",
            "default": "active"
          },
          "contacts": {
            "items": {
              "$ref": "#/components/schemas/Contact"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Contacts",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "title": "ClientCreate"
      },
      "ClientOrderStats": {
        "properties": {
          "client_id": {
            "$ref": "#/components/schemas/PydanticObjectId"
          },
          "order_count": {
            "type": "integer",
            "title": "Order Count"
          },
          "total_value": {
            "type": "number",
            "title": "Total Value"
          }
        },
        "type": "object",
        "required": [
          "client_id",
          "order_count",
          "total_value"
        ],
        "title": "ClientOrderStats",
        "description": "One client's order count and total order value."
      },
      "ClientOut": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/PydanticObjectId"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "status": {
            "$ref": "#/components/schemas/ClientStatus"
          },
          "contacts": {
            "items": {
              "$ref": "#/components/schemas/Contact"
            },
            "type": "array",
            "title": "Contacts"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "status",
          "contacts",
          "created_at",
          "updated_at"
        ],
        "title": "ClientOut"
      },
      "ClientStatus": {
        "type": "string",
        "enum": [
          "active",
          "inactive"
        ],
        "title": "ClientStatus"
      },
      "ClientUpdate": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "status": {
            "$ref": "#/components/schemas/ClientStatus"
          },
          "contacts": {
            "items": {
              "$ref": "#/components/schemas/Contact"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Contacts"
          }
        },
        "type": "object",
        "required": [
          "name",
          "email",
          "status",
          "contacts"
        ],
        "title": "ClientUpdate",
        "description": "PUT replaces the whole client, so every field is required: one left\nout is an error, never a reset to the create default."
      },
      "Contact": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          }
        },
        "type": "object",
        "required": [
          "name",
          "role",
          "phone"
        ],
        "title": "Contact",
        "description": "Embedded sub-document: contacts are always loaded with their client,\nnever queried on their own, and the list is bounded \u2014 the textbook case\nfor embedding over a separate collection."
      },
      "ErrorModel": {
        "properties": {
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "status",
          "detail"
        ],
        "title": "ErrorModel",
        "description": "The body of every non-2XX response, in RFC 9457's member names (\u00a73.1),\nwith `status` and `detail` required. Sent as plain application/json."
      },
      "FieldErrorModel": {
        "properties": {
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "status",
          "detail",
          "fields"
        ],
        "title": "FieldErrorModel",
        "description": "A failure attributable to named inputs, so a form can mark them."
      },
      "HealthCheck": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthCheck"
      },
      "OrderCreate": {
        "properties": {
          "client_id": {
            "$ref": "#/components/schemas/PydanticObjectId"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "title": "Description"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "unit_price": {
            "type": "number",
            "minimum": 0.0,
            "title": "Unit Price"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus",
            "default": "draft"
          }
        },
        "type": "object",
        "required": [
          "client_id",
          "description",
          "quantity",
          "unit_price"
        ],
        "title": "OrderCreate"
