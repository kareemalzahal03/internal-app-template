{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": { "()": "app.core.logging.JsonFormatter" }
  },
  "handlers": {
    "stderr": { "class": "logging.StreamHandler", "formatter": "json" }
  },
  "root": { "level": "WARNING", "handlers": ["stderr"] },
  "loggers": {
    "app": { "level": "INFO" },
    "uvicorn": { "level": "INFO" }
  }
}
