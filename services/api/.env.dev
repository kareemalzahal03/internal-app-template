# The api's dev environment. Committed: all dev-only.
# Every variable is required; a deployment sets each in its environment.

# The deployment, with driver options: each operation gets ten seconds, and
# the server's logs name the app's connections.
MONGODB_URL=mongodb://localhost:27017/?timeoutMS=10000&appName=devApp
MONGODB_DB=appdb

# The one origin; every URL registered with the provider derives from it.
APP_URL=http://localhost:8000

# Signs the OAuth state cookie. For a deployment: python -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_STATE_SECRET=dev-oauth-state-secret-not-for-production

# How the api proves to the provider that it is the client: a private RSA key
# as one line of JSON. The api serves only its public half, for the provider
# to fetch. Make one for a deployment with `just client-key`; a provider
# that takes no key gets an OIDC_CLIENT_SECRET instead.
