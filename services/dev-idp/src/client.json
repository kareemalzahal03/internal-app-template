{
  "client_name": "Internal App",
  "application_type": "web",
  "redirect_uris": [
    "http://localhost:8000/api/auth/callback"
  ],
  "response_types": [
    "code"
  ],
  "grant_types": [
    "authorization_code"
  ],
  "token_endpoint_auth_method": "private_key_jwt",
  "token_endpoint_auth_signing_alg": "RS256",
  "jwks_uri": "http://localhost:8000/api/auth/jwks",
  "scope": "openid profile email",
  "post_logout_redirect_uris": [
    "http://localhost:8000/login"
  ],
  "frontchannel_logout_uri": "http://localhost:8000/api/auth/frontchannel-logout",
  "frontchannel_logout_session_required": true,
  "backchannel_logout_uri": "http://localhost:8000/api/auth/backchannel-logout",
  "backchannel_logout_session_required": true
}
