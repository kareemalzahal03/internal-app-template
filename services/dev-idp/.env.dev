# The provider's identity, read by both the provider and the api.
# Point these at Entra, Okta or Cognito and nothing else changes.

# Discovery is read from under this, and its `issuer` checked against it.
OIDC_ISSUER=http://localhost:8080
# Dev-only and committed; a real provider issues its own.
OIDC_CLIENT_ID=dev-client
